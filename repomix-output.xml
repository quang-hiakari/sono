<file path="supabase/migrations/0001_init.sql">
-- profiles extends auth.users with role
create table profiles (
  id uuid primary key references auth.users(id) on delete cascade,
  role text not null check (role in ('owner','sister')),
  email text not null,
  full_name text,
  created_at timestamptz not null default now()
);

-- debts table
create table debts (
  id uuid primary key default gen_random_uuid(),
  owner_id uuid not null references profiles(id) on delete cascade,
  title text not null,
  amount numeric(12,2) not null check (amount > 0),
  notes text,
  debt_date date not null default current_date,
  created_at timestamptz not null default now()
);
create index debts_owner_created_idx on debts(owner_id, created_at desc);

-- payments table
create table payments (
  id uuid primary key default gen_random_uuid(),
  sister_id uuid not null references profiles(id) on delete cascade,
  debt_id uuid references debts(id) on delete set null,
  amount numeric(12,2) not null check (amount > 0),
  receipt_url text,
  note text,
  created_at timestamptz not null default now()
);
create index payments_sister_created_idx on payments(sister_id, created_at desc);
create index payments_debt_idx on payments(debt_id);

-- Auto-create profile on signup
create or replace function public.handle_new_user() returns trigger as $$
begin
  insert into public.profiles (id, email, role)
  values (new.id, new.email, 'sister')
  on conflict (id) do nothing;
  return new;
end; $$ language plpgsql security definer;

drop trigger if exists on_auth_user_created on auth.users;
create trigger on_auth_user_created
  after insert on auth.users
  for each row execute function public.handle_new_user();

-- RLS
alter table profiles enable row level security;
alter table debts    enable row level security;
alter table payments enable row level security;

-- profiles: any authenticated user reads all (family of 2)
create policy profiles_read_all on profiles for select
  using (auth.uid() is not null);

-- debts: owner full access; sister read-only
create policy debts_owner_all on debts for all
  using (exists (select 1 from profiles p where p.id = auth.uid() and p.role = 'owner'))
  with check (owner_id = auth.uid());

create policy debts_sister_read on debts for select
  using (exists (select 1 from profiles p where p.id = auth.uid() and p.role = 'sister'));

-- payments: sister insert + read own; owner read all
create policy payments_sister_rw on payments for all
  using (sister_id = auth.uid())
  with check (
    sister_id = auth.uid()
    and exists (select 1 from profiles p where p.id = auth.uid() and p.role = 'sister')
  );

create policy payments_owner_read on payments for select
  using (exists (select 1 from profiles p where p.id = auth.uid() and p.role = 'owner'));

-- storage RLS (run after creating receipts bucket)
create policy receipts_sister_upload on storage.objects for insert
  to authenticated with check (
    bucket_id = 'receipts'
    and (storage.foldername(name))[1] = auth.uid()::text
  );

create policy receipts_read on storage.objects for select
  to authenticated using (
    bucket_id = 'receipts' and (
      (storage.foldername(name))[1] = auth.uid()::text
      or exists (select 1 from profiles p where p.id = auth.uid() and p.role = 'owner')
    )
  );
</file>

<file path="supabase/migrations/0002_multi_user_books.sql">
-- ============================================================
-- Migration 0002: Multi-user debt books + payment approval
-- Run this in the Supabase SQL Editor.
-- ============================================================

-- 1. Drop old RLS policies
drop policy if exists profiles_read_all on profiles;
drop policy if exists debts_owner_all on debts;
drop policy if exists debts_sister_read on debts;
drop policy if exists payments_sister_rw on payments;
drop policy if exists payments_owner_read on payments;
drop policy if exists receipts_sister_upload on storage.objects;
drop policy if exists receipts_read on storage.objects;

-- 2. Drop old tables (cascades to indexes + FK deps)
drop table if exists payments cascade;
drop table if exists debts cascade;

-- 3. Remove role column from profiles
alter table profiles drop column if exists role;

-- 4. Update trigger: no longer sets default role
create or replace function public.handle_new_user() returns trigger as $$
begin
  insert into public.profiles (id, email)
  values (new.id, new.email)
  on conflict (id) do nothing;
  return new;
end; $$ language plpgsql security definer;

-- 5. Create debt_books
create table debt_books (
  id           uuid primary key default gen_random_uuid(),
  name         text not null,
  creditor_id  uuid not null references profiles(id) on delete cascade,
  debtor_id    uuid not null references profiles(id) on delete cascade,
  created_at   timestamptz not null default now(),
  constraint debt_books_no_self_ref check (creditor_id <> debtor_id)
);
create index debt_books_creditor_idx on debt_books(creditor_id);
create index debt_books_debtor_idx   on debt_books(debtor_id);

-- 6. Create debts (book-scoped)
create table debts (
  id           uuid primary key default gen_random_uuid(),
  book_id      uuid not null references debt_books(id) on delete cascade,
  creditor_id  uuid not null references profiles(id),
  title        text not null,
  amount       numeric(12,2) not null check (amount > 0),
  notes        text,
  debt_date    date not null default current_date,
  created_at   timestamptz not null default now()
);
create index debts_book_created_idx on debts(book_id, created_at desc);

-- 7. Create payments (book-scoped, with approval status)
create table payments (
  id               uuid primary key default gen_random_uuid(),
  book_id          uuid not null references debt_books(id) on delete cascade,
  debtor_id        uuid not null references profiles(id),
  amount           numeric(12,2) not null check (amount > 0),
  receipt_url      text,
  note             text,
  status           text not null default 'pending'
                     check (status in ('pending','approved','rejected')),
  rejection_reason text,
  reviewed_at      timestamptz,
  created_at       timestamptz not null default now()
);
create index payments_book_created_idx on payments(book_id, created_at desc);
create index payments_debtor_idx        on payments(debtor_id, created_at desc);
create index payments_status_idx        on payments(book_id, status);

-- 8. RLS: profiles
-- (already enabled; just recreate policy)
drop policy if exists profiles_read_all on profiles;
create policy profiles_read_all on profiles
  for select using (auth.uid() is not null);

-- 9. RLS: debt_books
alter table debt_books enable row level security;

create policy books_member_select on debt_books for select
  using (auth.uid() = creditor_id or auth.uid() = debtor_id);

create policy books_creditor_insert on debt_books for insert
  with check (auth.uid() = creditor_id);

create policy books_creditor_update on debt_books for update
  using (auth.uid() = creditor_id);

create policy books_creditor_delete on debt_books for delete
  using (auth.uid() = creditor_id);

-- 10. RLS: debts
alter table debts enable row level security;

create policy debts_member_select on debts for select
  using (exists (
    select 1 from debt_books b
    where b.id = book_id
      and (b.creditor_id = auth.uid() or b.debtor_id = auth.uid())
  ));

create policy debts_creditor_write on debts for all
  using (creditor_id = auth.uid())
  with check (creditor_id = auth.uid());

-- 11. RLS: payments
alter table payments enable row level security;

create policy payments_member_select on payments for select
  using (exists (
    select 1 from debt_books b
    where b.id = book_id
      and (b.creditor_id = auth.uid() or b.debtor_id = auth.uid())
  ));

create policy payments_debtor_insert on payments for insert
  with check (
    debtor_id = auth.uid()
    and exists (
      select 1 from debt_books b
      where b.id = book_id and b.debtor_id = auth.uid()
    )
  );

-- Creditor can update status (approve/reject)
create policy payments_creditor_update on payments for update
  using (exists (
    select 1 from debt_books b
    where b.id = book_id and b.creditor_id = auth.uid()
  ));

-- 12. Storage RLS for receipts bucket
create policy receipts_debtor_upload on storage.objects for insert
  to authenticated with check (
    bucket_id = 'receipts'
    and (storage.foldername(name))[1] = auth.uid()::text
  );

create policy receipts_member_read on storage.objects for select
  to authenticated using (
    bucket_id = 'receipts' and (
      (storage.foldername(name))[1] = auth.uid()::text
      or exists (
        select 1 from payments p
        join debt_books b on b.id = p.book_id
        where p.receipt_url = name
          and b.creditor_id = auth.uid()
      )
    )
  );
</file>

