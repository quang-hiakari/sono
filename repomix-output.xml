<file path="lib/queries/book-ledger.ts">
import { createClient } from '@/lib/supabase/server';

export interface LedgerTotals {
  total: number;
  paid: number;
  remaining: number;
  pendingCount: number;
}

export interface Debt {
  id: string;
  book_id: string;
  title: string;
  amount: number;
  notes: string | null;
  debt_date: string;
  created_at: string;
}

export interface Payment {
  id: string;
  book_id: string;
  debtor_id: string;
  amount: number;
  receipt_url: string | null;
  note: string | null;
  status: 'pending' | 'approved' | 'rejected';
  rejection_reason: string | null;
  reviewed_at: string | null;
  created_at: string;
}

export async function getLedgerTotals(bookId: string): Promise<LedgerTotals> {
  const supabase = await createClient();
  const [{ data: debts }, { data: approved }, { data: pending }] = await Promise.all([
    supabase.from('debts').select('amount').eq('book_id', bookId),
    supabase.from('payments').select('amount').eq('book_id', bookId).eq('status', 'approved'),
    supabase.from('payments').select('id').eq('book_id', bookId).eq('status', 'pending'),
  ]);
  const total = (debts ?? []).reduce((s, d) => s + Number(d.amount), 0);
  const paid = (approved ?? []).reduce((s, p) => s + Number(p.amount), 0);
  return { total, paid, remaining: total - paid, pendingCount: (pending ?? []).length };
}

export async function getDebts(bookId: string): Promise<Debt[]> {
  const supabase = await createClient();
  const { data } = await supabase
    .from('debts')
    .select('id, book_id, title, amount, notes, debt_date, created_at')
    .eq('book_id', bookId)
    .order('created_at', { ascending: false });
  return (data ?? []) as Debt[];
}

export async function getAllPayments(bookId: string): Promise<Payment[]> {
  const supabase = await createClient();
  const { data } = await supabase
    .from('payments')
    .select('id, book_id, debtor_id, amount, receipt_url, note, status, rejection_reason, reviewed_at, created_at')
    .eq('book_id', bookId)
    .order('created_at', { ascending: false });
  return (data ?? []) as Payment[];
}

export async function getPendingPayments(bookId: string): Promise<Payment[]> {
  const supabase = await createClient();
  const { data } = await supabase
    .from('payments')
    .select('id, book_id, debtor_id, amount, receipt_url, note, status, rejection_reason, reviewed_at, created_at')
    .eq('book_id', bookId)
    .eq('status', 'pending')
    .order('created_at', { ascending: true });
  return (data ?? []) as Payment[];
}

export async function getMyPayments(bookId: string, debtorId: string): Promise<Payment[]> {
  const supabase = await createClient();
  const { data } = await supabase
    .from('payments')
    .select('id, book_id, debtor_id, amount, receipt_url, note, status, rejection_reason, reviewed_at, created_at')
    .eq('book_id', bookId)
    .eq('debtor_id', debtorId)
    .order('created_at', { ascending: false });
  return (data ?? []) as Payment[];
}
</file>

