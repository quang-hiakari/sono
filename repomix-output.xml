                    ))}
                  </div>
                )}
                {myPayments.length > 3 && (
                  <Link href={`/books/${bookId}/payments`} className="block text-center text-sm text-blue-600 mt-3 hover:underline">
                    Xem tất cả →
                  </Link>
                )}
              </CardContent>
            </Card>
          </>
        )}
      </div>
    </PageContainer>
  );
