<file path="app/api/webhooks/payment-created/route.ts">
import { createAdminClient } from '@/lib/supabase/admin';
import { sendPaymentNotification } from '@/lib/email/send-payment-notification';

export const runtime = 'edge';

export async function POST(req: Request) {
  const secret = req.headers.get('x-webhook-secret');
  if (secret !== process.env.WEBHOOK_SECRET) {
    return new Response('Unauthorized', { status: 401 });
  }

  let body: Record<string, unknown>;
  try {
    body = await req.json();
  } catch {
    return new Response('Bad request', { status: 400 });
  }

  const record = body?.record as Record<string, unknown> | undefined;
  const paymentId = record?.id as string | undefined;
  if (!paymentId) return new Response('Missing payment id', { status: 400 });

  const admin = createAdminClient();

  // Fetch payment with book and profiles
  const { data: payment } = await admin
    .from('payments')
    .select(`
      id, amount, note, receipt_url, created_at, book_id, debtor_id,
      debtor:profiles!debtor_id(email, full_name),
      book:debt_books!book_id(
        creditor_id,
        creditor:profiles!creditor_id(email, full_name)
      )
    `)
    .eq('id', paymentId)
    .single();

  if (!payment) return new Response('Payment not found', { status: 404 });

  const book = (payment.book as unknown) as {
    creditor_id: string;
    creditor: { email: string; full_name: string | null };
  } | null;
  const debtor = (payment.debtor as unknown) as { email: string; full_name: string | null } | null;

  if (!book?.creditor?.email) return new Response('ok', { status: 200 });

  let receiptUrl: string | null = null;
  if (payment.receipt_url) {
    const { data } = await admin.storage
      .from('receipts')
      .createSignedUrl(payment.receipt_url, 60 * 60 * 24 * 7);
    receiptUrl = data?.signedUrl ?? null;
  }

  const debtorName = debtor?.full_name ?? debtor?.email ?? 'Người nợ';
  const appUrl = process.env.NEXT_PUBLIC_APP_URL ?? '';
  const approvalUrl = `${appUrl}/books/${payment.book_id}/payments`;

  try {
    await sendPaymentNotification({
      to: book.creditor.email,
      debtorName,
      amount: Number(payment.amount),
      note: payment.note,
      createdAt: payment.created_at,
      receiptUrl,
      approvalUrl,
    });
  } catch (err) {
    console.error('[webhook] email send failed:', err);
  }

  return new Response('ok', { status: 200 });
}
