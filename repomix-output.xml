import { createClient } from '@/lib/supabase/server';

export interface DebtBook {
  id: string;
  name: string;
  creditor_id: string;
  debtor_id: string;
  created_at: string;
  creditor: { email: string; full_name: string | null };
  debtor: { email: string; full_name: string | null };
}

export async function getMyBooks(userId: string): Promise<DebtBook[]> {
  const supabase = await createClient();
  const { data } = await supabase
    .from('debt_books')
    .select('*, creditor:profiles!creditor_id(email, full_name), debtor:profiles!debtor_id(email, full_name)')
    .or(`creditor_id.eq.${userId},debtor_id.eq.${userId}`)
    .order('created_at', { ascending: false });
  return (data ?? []) as unknown as DebtBook[];
}

export async function getBook(bookId: string): Promise<DebtBook | null> {
  const supabase = await createClient();
  const { data } = await supabase
    .from('debt_books')
    .select('*, creditor:profiles!creditor_id(email, full_name), debtor:profiles!debtor_id(email, full_name)')
    .eq('id', bookId)
    .single();
  return data as unknown as DebtBook | null;
}

export function getPartnerName(book: DebtBook, myId: string): string {
  if (book.creditor_id === myId) {
    return book.debtor.full_name ?? book.debtor.email;
  }
  return book.creditor.full_name ?? book.creditor.email;
}
