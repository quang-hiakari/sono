## Implementation Steps

1. **Simplify `get-current-user.ts`** — return `{ id, email, profile }`, no role field.

2. **`lib/queries/books.ts`**:
```ts
export interface DebtBook {
  id: string;
  name: string;
  creditor_id: string;
  debtor_id: string;
  creditor: { email: string; full_name: string | null };
  debtor: { email: string; full_name: string | null };
  created_at: string;
}

export async function getMyBooks(userId: string): Promise<DebtBook[]> {
  const supabase = await createClient();
  const { data } = await supabase
    .from('debt_books')
    .select('*, creditor:profiles!creditor_id(email,full_name), debtor:profiles!debtor_id(email,full_name)')
    .or(`creditor_id.eq.${userId},debtor_id.eq.${userId}`)
    .order('created_at', { ascending: false });
  return (data ?? []) as DebtBook[];
}

export async function getBook(bookId: string): Promise<DebtBook | null> {
  const supabase = await createClient();
  const { data } = await supabase
    .from('debt_books')
    .select('*, creditor:profiles!creditor_id(email,full_name), debtor:profiles!debtor_id(email,full_name)')
    .eq('id', bookId)
    .single();
  return data as DebtBook | null;
}
```

3. **Create book action** `app/books/new/actions.ts`:
```ts
'use server';
