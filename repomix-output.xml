'use server';

import { revalidatePath } from 'next/cache';
import { z } from 'zod';
import { createClient } from '@/lib/supabase/server';
import { getCurrentUser } from '@/lib/auth/get-current-user';
import { getBook } from '@/lib/queries/books';
import { sendRejectionNotification } from '@/lib/email/send-rejection-notification';

const paymentSchema = z.object({
  amount: z.coerce.number().positive(),
  note: z.string().max(500).optional(),
  receipt_path: z.string().min(1),
});

function revalidateBook(bookId: string) {
  revalidatePath(`/books/${bookId}`);
  revalidatePath(`/books/${bookId}/payments`);
}

export async function createPayment(bookId: string, formData: FormData) {
  const me = await getCurrentUser();
  const book = await getBook(bookId);
  if (!me || !book || book.debtor_id !== me.id) return { error: 'Không có quyền.' };

  const parsed = paymentSchema.safeParse(Object.fromEntries(formData));
  if (!parsed.success) return { error: 'Dữ liệu không hợp lệ.' };

  const supabase = await createClient();
  const { error } = await supabase.from('payments').insert({
    book_id: bookId,
    debtor_id: me.id,
    amount: parsed.data.amount,
    note: parsed.data.note ?? null,
    receipt_url: parsed.data.receipt_path,
    status: 'pending',
  });

  if (error) return { error: error.message };

  revalidateBook(bookId);
  return {};
}

export async function approvePayment(bookId: string, paymentId: string) {
  const me = await getCurrentUser();
  const book = await getBook(bookId);
  if (!me || !book || book.creditor_id !== me.id) return { error: 'Không có quyền.' };

  const supabase = await createClient();
  const { error } = await supabase
    .from('payments')
    .update({ status: 'approved', reviewed_at: new Date().toISOString() })
    .eq('id', paymentId)
    .eq('book_id', bookId);

  if (error) return { error: error.message };

  revalidateBook(bookId);
  return {};
}

export async function rejectPayment(bookId: string, paymentId: string, reason: string) {
  const me = await getCurrentUser();
  const book = await getBook(bookId);
  if (!me || !book || book.creditor_id !== me.id) return { error: 'Không có quyền.' };

  const supabase = await createClient();

  // Fetch payment to get debtor email and amount for notification
  const { data: payment } = await supabase
    .from('payments')
    .select('amount, debtor_id')
    .eq('id', paymentId)
    .eq('book_id', bookId)
    .single();

  const { error } = await supabase
    .from('payments')
    .update({
      status: 'rejected',
      rejection_reason: reason.trim() || null,
      reviewed_at: new Date().toISOString(),
    })
    .eq('id', paymentId)
    .eq('book_id', bookId);

  if (error) return { error: error.message };

  // Send rejection email to debtor (best-effort)
  if (payment) {
    const { data: debtorProfile } = await supabase
      .from('profiles')
      .select('email, full_name')
      .eq('id', payment.debtor_id)
      .single();

    if (debtorProfile?.email) {
      try {
        const creditorName = me.profile.full_name ?? me.email;
        const appUrl = process.env.NEXT_PUBLIC_APP_URL ?? '';
        await sendRejectionNotification({
          to: debtorProfile.email,
          creditorName,
          amount: Number(payment.amount),
          reason: reason.trim() || null,
          dashboardUrl: `${appUrl}/books/${bookId}/payments`,
        });
      } catch (err) {
        console.error('[rejectPayment] email failed:', err);
      }
    }
  }

  revalidateBook(bookId);
  return {};
}
